# Database
DATABASE_URL=postgresql+asyncpg://citymap:citymap@localhost:5433/citymap
DATABASE_URL_SYNC=postgresql://citymap:citymap@localhost:5433/citymap

# Martin tile server
MARTIN_URL=http://localhost:3030

# MinIO (S3-compatible object storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=citymap-tiles
S3_REGION=us-east-1

# Foursquare API (POI supplementary import + contact-list phone lookup)
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# Google Places API (New) — contact-list phone lookup. Needs "Places API (New)" enabled.
# Phone numbers bill at the Enterprise Text Search SKU: 1,000 free/month, then ~$35/1,000.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Phone lookup order (first match wins). Per-city override: "city=prov1,prov2;city2=..."
PHONE_LOOKUP_PROVIDERS=foursquare,google
PHONE_LOOKUP_PROVIDERS_BY_CITY=chicago=google,foursquare;detroit=google,foursquare;dayton=google,foursquare
PHONE_LOOKUP_RATE_PER_MINUTE=60

# Owner skip trace (owner phones/emails, incl. people behind LLCs). Paid per hit.
# Tracerfy: https://www.tracerfy.com  ($0.10/instant lookup, misses free)
TRACERFY_API_KEY=your_tracerfy_api_key_here
# BatchData: no pay-per-call plan (from $2,000/month) — leave disabled unless purchased,
# then add its key and set OWNER_LOOKUP_PROVIDERS=tracerfy,batchdata
BATCHDATA_API_KEY=
OWNER_LOOKUP_PROVIDERS=tracerfy
OWNER_LOOKUP_RATE_PER_MINUTE=20

# Where the contact-list CSV is saved when a lookup finishes / Export CSV is pressed.
# "" turns it off (the map then falls back to a normal browser download).
CSV_EXPORT_DIR=~/Desktop

# Pelias geocoder (self-hosted)
PELIAS_URL=http://localhost:4000

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
# Origin only (paths add /api/v1). Empty = same server as the map (the map server).
VITE_API_URL=http://localhost:8000
VITE_MARTIN_URL=http://localhost:3030
# Lookup server for the static-mode map (backend/app/map_server.py). The built map
# (npm run build:local) uses the relative "/api/v1"; this value is for ./start_map.sh dev.
VITE_PHONE_API_URL=http://localhost:8000/api/v1
VITE_BASEMAP_URL=https://protomaps.github.io/basemaps-assets/v4.bin
