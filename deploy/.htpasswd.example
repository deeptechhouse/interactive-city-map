# =============================================================================
# .htpasswd — Password File for Basic Authentication
# =============================================================================
#
# This file should NOT be committed to version control.
# It must be placed in your DreamHost home directory (not the web root).
#
# Generate this file on your DreamHost server:
#
#   htpasswd -c /home/YOUR_USERNAME/.htpasswd firstuser
#
# To add additional users:
#
#   htpasswd /home/YOUR_USERNAME/.htpasswd anotheruser
#
# To change an existing user's password:
#
#   htpasswd /home/YOUR_USERNAME/.htpasswd existinguser
#
# Example entry (username: demo, password: demo — DO NOT use in production):
# demo:$apr1$xyz$examplehashhere
#
# IMPORTANT:
#   1. The .htaccess AuthUserFile path must match where you place this file
#   2. Use absolute paths (e.g., /home/yourusername/.htpasswd)
#   3. The file must be readable by Apache but NOT inside the web root
